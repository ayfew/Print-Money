# Copy to .env and fill in ONLY if you intend to trade live.
# Paper trading needs none of this.
#
# Load it yourself before running, e.g.
#     bash:       set -a; source .env; set +a
#     powershell: Get-Content .env | ForEach-Object { if ($_ -match '^(\w+)=(.*)$') { Set-Item "env:$($Matches[1])" $Matches[2] } }
#
# The private key is read from the environment at the moment of use. It is never
# written to disk by this project, never logged, and never sent anywhere except
# the Polymarket signing client. Do not put it in config.yaml.

POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER=

# Optional: stored CLOB API credentials. Leave blank and they are derived from
# the signing key on first use.
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# Optional overrides, handy for one-off runs
# PM_CAPITAL=250
# PM_MIN_EDGE=0.02
# PM_MODE=paper
# PM_LOG_LEVEL=DEBUG
