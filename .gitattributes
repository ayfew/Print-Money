# iCalendar is defined in terms of CRLF. If git normalises it on checkout the
# file stops parsing, and the cloud runner checks out on Linux where it would.
# Marking it binary is the only thing that reliably keeps git's hands off it.
*.ics -text

# Batch files are the opposite case: they need CRLF wherever they land.
*.cmd text eol=crlf
*.bat text eol=crlf

# Everything else is normal source.
*.py    text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf

# The claims log is appended to from a Windows laptop and a Linux runner alike.
# Without this git hands each of them a different line ending and every append
# rewrites the whole file, burying one new call in a two-hundred-line diff.
*.jsonl text eol=lf
*.txt   text eol=lf
*.html  text eol=lf
